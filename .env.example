# ─── StreamCraft Environment Variables ─────────────────────────────────────────
# Copy this file to .env.local for local development
# For production: set these in Render → Environment Variables

# ── YouTube Cookies (Authentication & Rate-Limit Bypass) ────────────────────────
# Export using: "Get cookies.txt LOCALLY" Chrome extension on youtube.com
# Paste the ENTIRE Netscape cookie content here.
YOUTUBE_COOKIES=

# Optional: Add extra cookie accounts for rotation
# YOUTUBE_COOKIES_2=

# ── Residential Proxies (Bypass Cloud Datacenter Rate Limits) ───────────────────
# You can provide a single proxy, a rotating gateway, or multiple proxies.
# Supported formats:
#   http://username:password@host:port
#   socks5://username:password@host:port

# Option A: Single proxy OR rotating gateway (e.g. from webshare.io, brightdata, oxylabs)
PROXY_URL=

# Option B: Multiple proxies in a single variable (comma or newline separated)
# PROXY_URL=http://user:pass@proxy1.com:8080, http://user:pass@proxy2.com:8080

# Option C: Numbered proxies for automatic random load balancing
# PROXY_URL_1=http://user:pass@proxy1.com:8080
# PROXY_URL_2=http://user:pass@proxy2.com:8080
# PROXY_URL_3=http://user:pass@proxy3.com:8080

# ── Proof of Origin (PO Token) ──────────────────────────────────────────────────
# Optional PO Token to bypass bot detection on datacenter IPs
# PO_TOKEN=

# ── Vite Dev Proxy (Local dev only) ─────────────────────────────────────────────
# Point Vite proxy at a remote Render backend instead of localhost
# VITE_API_URL=https://streamcraft-backend.onrender.com
