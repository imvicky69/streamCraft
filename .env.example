# ─── StreamCraft Environment Variables ─────────────────────────────────────────
# Copy this file to .env.local for local development
# For production: set these in Render → Environment Variables

# Your YouTube cookies in Netscape format (base64 encoded or raw)
# Export using: "Get cookies.txt LOCALLY" Chrome extension on youtube.com
# Then paste the ENTIRE content of the cookies.txt file here as the value.
YOUTUBE_COOKIES=

# Optional: Add more cookie accounts for rotation (helps avoid rate limits)
# YOUTUBE_COOKIES_2=

# Local dev only: point Vite proxy at a remote Render backend instead of localhost
# VITE_API_URL=https://streamcraft-backend.onrender.com
